{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.werwa/events/werwa.onboarding.wallet.registered.v1.schema.json",
  "title": "werwa.onboarding.wallet.registered.v1",
  "description": "Bên phát: Onboarding. Bên nhận: Phân phối.",
  "allOf": [
    {
      "$ref": "cloudevent.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "werwa.onboarding.wallet.registered.v1"
    },
    "source": {
      "const": "/werwa/onboarding"
    },
    "data": {
      "type": "object",
      "required": [
        "walletId",
        "address",
        "onchainId"
      ],
      "properties": {
        "walletId": {
          "type": "string",
          "format": "uuid",
          "description": "UUIDv7"
        },
        "address": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "onchainId": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        }
      },
      "additionalProperties": true
    }
  }
}
