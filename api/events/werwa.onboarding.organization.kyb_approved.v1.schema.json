{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.werwa/events/werwa.onboarding.organization.kyb_approved.v1.schema.json",
  "title": "werwa.onboarding.organization.kyb_approved.v1",
  "description": "Bên phát: Onboarding. Bên nhận: Quản trị.",
