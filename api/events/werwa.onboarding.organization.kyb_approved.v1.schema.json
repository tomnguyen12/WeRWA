            "type": "string",
            "enum": [
              "ISSUER",
              "OPERATING_AGENCY",
              "SYNDICATE",
              "REGISTRAR",
              "PAYING_AGENT",
              "TREASURY",
              "CUSTODIAN",
              "TRUSTEE",
              "SUPERVISOR",
              "OPERATOR",
              "INVESTOR"
            ]
          }
        }
      },
      "additionalProperties": true
    }
