{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.werwa/events/werwa.onchain.event.indexed.v1.schema.json",
  "title": "werwa.onchain.event.indexed.v1",
  "description": "Bên phát: Onchain. Bên nhận: Phân phối (bảng đọc).",
  "allOf": [
    {
      "$ref": "cloudevent.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "werwa.onchain.event.indexed.v1"
    },
    "source": {
      "const": "/werwa/onchain"
    },
    "data": {
      "type": "object",
      "required": [
        "contract",
        "eventName",
        "block",
        "logIndex"
      ],
      "properties": {
        "contract": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$"
        },
        "eventName": {
          "type": "string"
        },
        "block": {
          "type": "integer"
        },
        "logIndex": {
          "type": "integer"
        },
        "txHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        },
        "contractKind": {
          "type": "string"
        },
        "args": {
          "type": "object",
          "description": "Tham số sự kiện đã giải mã theo ABI; số nguyên dạng chuỗi thập phân, địa chỉ và bytes dạng hex (Q84)",
          "additionalProperties": true
        },
        "blockTime": {
          "type": "string",
          "format": "date-time",
          "description": "Giờ của khối theo header (Q84)"
        }
      },
      "additionalProperties": true
    }
  }
}
