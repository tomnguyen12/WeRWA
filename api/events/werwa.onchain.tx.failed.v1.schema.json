{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.werwa/events/werwa.onchain.tx.failed.v1.schema.json",
  "title": "werwa.onchain.tx.failed.v1",
  "description": "Bên phát: Onchain. Bên nhận: Mô-đun gửi giao dịch, Quản trị.",
  "allOf": [
    {
      "$ref": "cloudevent.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "werwa.onchain.tx.failed.v1"
    },
    "source": {
      "const": "/werwa/onchain"
    },
    "data": {
      "type": "object",
      "required": [
        "txId",
        "reason"
      ],
      "properties": {
        "txId": {
          "type": "string",
          "format": "uuid",
          "description": "UUIDv7"
        },
        "reason": {
          "type": "string"
        }
      },
      "additionalProperties": true
    }
  }
}
