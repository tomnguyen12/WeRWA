{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.werwa/events/werwa.issuance.series.approved.v1.schema.json",
  "title": "werwa.issuance.series.approved.v1",
  "description": "Bên phát: Phát hành. Bên nhận: Quản trị.",
  "allOf": [
    {
      "$ref": "cloudevent.schema.json"
    }
  ],
  "properties": {
    "type": {
      "const": "werwa.issuance.series.approved.v1"
    },
    "source": {
      "const": "/werwa/issuance"
    },
    "data": {
      "type": "object",
      "required": [
        "seriesId",
        "termsHash"
      ],
      "properties": {
        "seriesId": {
          "type": "string",
          "format": "uuid",
          "description": "UUIDv7"
        },
        "termsHash": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{64}$"
        }
      },
      "additionalProperties": true
    }
  }
}
