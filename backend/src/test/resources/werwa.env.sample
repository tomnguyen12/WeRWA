# Mẫu đúng định dạng tệp env gộp do infra/werwa.sh sinh (I11, I13), giá trị giả, chỉ cho kiểm thử bind cấu hình.

SPRING_DATASOURCE_URL=jdbc:postgresql://127.0.0.1:5432/werwa
SPRING_DATASOURCE_USERNAME=werwa_app
SPRING_DATASOURCE_PASSWORD=gia-tri-gia

WERWA_NATS_URL=nats://127.0.0.1:4222
WERWA_NATS_USERNAME=werwa_app
WERWA_NATS_PASSWORD=gia-tri-gia
WERWA_NATS_STREAM=WERWA

SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_ISSUERURI=http://localhost:8180/realms/werwa
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_JWKSETURI=http://127.0.0.1:8180/realms/werwa/protocol/openid-connect/certs
SPRING_SECURITY_OAUTH2_RESOURCESERVER_JWT_AUDIENCES=werwa-api
WERWA_OIDC_CLIENTID=werwa-web

WERWA_CHAIN_ID=1337
WERWA_CHAIN_READURLS=http://127.0.0.1:8555,http://127.0.0.1:8565
WERWA_CHAIN_SUBMITURLS=http://127.0.0.1:8545,http://127.0.0.1:8546
WERWA_CHAIN_DEPLOYEDATBLOCK=12
WERWA_CHAIN_SIGNINGMODE=pkcs11

WERWA_CONTRACTS_TIMELOCK=0x1000000000000000000000000000000000000001
WERWA_CONTRACTS_SERIESFACTORY=0x1000000000000000000000000000000000000002
WERWA_CONTRACTS_IDENTITYREGISTRY=0x1000000000000000000000000000000000000003
WERWA_CONTRACTS_AUDITANCHOR=0x1000000000000000000000000000000000000004

WERWA_SAFES_GOVERNANCE3OF3=0x2000000000000000000000000000000000000001
WERWA_SAFES_ENFORCEMENT2OF2=0x2000000000000000000000000000000000000002

WERWA_SIGNER_URL=http://127.0.0.1:8745
WERWA_SIGNER_TOKEN=gia-tri-gia

WERWA_MONITORING_ALERTMANAGERURL=http://127.0.0.1:9093
