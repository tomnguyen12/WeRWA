<?xml version="1.0" encoding="UTF-8"?>
<!--
  Backend WeRWA: một khối triển khai, Spring Modulith, 6 mô-đun phân hệ + mô-đun dùng chung platform.
  Quyết định: ADR-10, ADR-11; D1 (Maven), D2 (gói vn.werwa), D5 (Spring Data JDBC), Q4 (Spring Boot 4.1.x, Modulith 2.1.x).
  Chỉ khai báo thư viện đã dùng; web3j thêm ở B3.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>vn.werwa</groupId>
    <artifactId>werwa-backend</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <name>werwa-backend</name>
    <description>Nền tảng ghi sổ trái phiếu số WeRWA</description>

    <properties>
        <java.version>21</java.version>
        <spring-modulith.version>2.1.2</spring-modulith.version>
        <openapi-generator.version>7.14.0</openapi-generator.version>
        <web3j.version>5.0.2</web3j.version>
        <awssdk.version>2.31.0</awssdk.version>
        <jnats.version>2.26.4</jnats.version>
        <json-schema-validator.version>1.5.8</json-schema-validator.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>software.amazon.awssdk</groupId>
                <artifactId>bom</artifactId>
                <version>${awssdk.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>org.springframework.modulith</groupId>
                <artifactId>spring-modulith-bom</artifactId>
                <version>${spring-modulith.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-security-oauth2-resource-server</artifactId>
        </dependency>
        <dependency>
            <!-- Chú thích Jackson dùng trong mô hình sinh từ OpenAPI -->
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-annotations</artifactId>
        </dependency>
        <dependency>
            <groupId>org.yaml</groupId>
            <artifactId>snakeyaml</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-jdbc</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-flyway</artifactId>
        </dependency>
        <dependency>
            <groupId>org.flywaydb</groupId>
            <artifactId>flyway-database-postgresql</artifactId>
        </dependency>
        <dependency>
            <groupId>org.postgresql</groupId>
            <artifactId>postgresql</artifactId>
            <scope>runtime</scope>
        </dependency>
        <dependency>
            <!-- Email thông báo (Q62) -->
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-mail</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-validation</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-core</artifactId>
        </dependency>
        <dependency>
            <!-- Sổ sự kiện JDBC làm outbox (D4, B2) -->
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-jdbc</artifactId>
        </dependency>
        <dependency>
            <!-- Gọi và đọc chuỗi qua JSON-RPC chuẩn EVM (ADR-11) -->
            <groupId>org.web3j</groupId>
            <artifactId>core</artifactId>
            <version>${web3j.version}</version>
        </dependency>
        <dependency>
            <!-- Kho tài liệu chuẩn S3: MinIO ở devnet, S3 của cloud trong nước ở môi trường thật (D7, Q30) -->
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>s3</artifactId>
        </dependency>
        <dependency>
            <groupId>software.amazon.awssdk</groupId>
            <artifactId>url-connection-client</artifactId>
        </dependency>
        <dependency>
            <groupId>io.nats</groupId>
            <artifactId>jnats</artifactId>
            <version>${jnats.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-configuration-processor</artifactId>
            <optional>true</optional>
        </dependency>

        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-testcontainers</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-postgresql</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.testcontainers</groupId>
            <artifactId>testcontainers-junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.modulith</groupId>
            <artifactId>spring-modulith-docs</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.awaitility</groupId>
            <artifactId>awaitility</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Máy chủ SMTP trong kiểm thử (Q62) -->
            <groupId>com.icegreen</groupId>
            <artifactId>greenmail</artifactId>
            <version>2.1.2</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.springframework.security</groupId>
            <artifactId>spring-security-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <!-- Kiểm response khớp lược đồ OpenAPI 3.1 (JSON Schema 2020-12) -->
            <groupId>com.networknt</groupId>
            <artifactId>json-schema-validator</artifactId>
            <version>${json-schema-validator.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
            </resource>
            <resource>
                <!-- Hợp đồng API: backend kiểm vai theo x-werwa-roles lúc chạy (B1.0) -->
                <directory>../api</directory>
                <includes>
                    <include>openapi.yaml</include>
                </includes>
                <targetPath>contract</targetPath>
            </resource>
            <resource>
                <!-- Danh mục và lược đồ sự kiện: chỉ phát loại có trong catalog (Q13) -->
                <directory>../api/events</directory>
                <targetPath>contract/events</targetPath>
            </resource>
            <resource>
                <!-- ABI: indexer giải mã log, chạy thử giải mã custom error (Q16, Q17) -->
                <directory>../api/abi</directory>
                <targetPath>contract/abi</targetPath>
            </resource>
            <resource>
                <!-- Cấu hình stream WERWA (I2): kiểm thử tạo stream từ đúng tệp của infra -->
                <directory>../infra/services/nats</directory>
                <includes>
                    <include>stream-werwa.json</include>
                </includes>
                <targetPath>contract/nats</targetPath>
            </resource>
            <resource>
                <!-- Vai của tổ chức thử devnet (I6), nguồn tạm tới B5 (Q5) -->
                <directory>../infra/keycloak/seed</directory>
                <includes>
                    <include>orgs.json</include>
                </includes>
                <targetPath>seed</targetPath>
            </resource>
        </resources>
        <testResources>
            <testResource>
                <directory>src/test/resources</directory>
            </testResource>
            <testResource>
                <!-- Genesis QBFT của devnet: kiểm thử dựng Besu một node từ đúng mẫu này (D9) -->
                <directory>../infra/devnet/config</directory>
                <includes>
                    <include>genesis.template.json</include>
                </includes>
                <targetPath>chain</targetPath>
            </testResource>
        </testResources>
        <plugins>
            <plugin>
                <!-- web3j-maven-plugin chỉ nhận ABI thuần với đuôi .abi: chép api/abi/*.json sang target/abi/*.abi -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <executions>
                    <execution>
                        <id>abi-for-web3j</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <copy todir="${project.build.directory}/abi">
                                    <fileset dir="${project.basedir}/../api/abi" includes="*.json" excludes="manifest.json"/>
                                    <globmapper from="*.json" to="*.abi"/>
                                </copy>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Lớp Java gọi hợp đồng sinh từ api/abi (ADR-11, B3) -->
                <groupId>org.web3j</groupId>
                <artifactId>web3j-maven-plugin</artifactId>
                <version>${web3j.version}</version>
                <executions>
                    <execution>
                        <id>werwa-contracts</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>generate-sources</goal>
                        </goals>
                        <configuration>
                            <packageName>vn.werwa.onchain.api.contracts</packageName>
                            <nativeJavaType>true</nativeJavaType>
                            <outputFormat>java</outputFormat>
                            <soliditySourceFiles>
                                <directory>${project.basedir}/src/main/solidity-none</directory>
                            </soliditySourceFiles>
                            <abiSourceFiles>
                                <directory>${project.build.directory}/abi</directory>
                                <includes>
                                    <include>*.abi</include>
                                </includes>
                            </abiSourceFiles>
                            <outputDirectory>
                                <java>${project.build.directory}/generated-sources/web3j</java>
                            </outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- web3j-maven-plugin không tự thêm thư mục sinh mã vào nguồn biên dịch -->
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>build-helper-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>add-web3j-sources</id>
                        <phase>generate-sources</phase>
                        <goals>
                            <goal>add-source</goal>
                        </goals>
                        <configuration>
                            <sources>
                                <source>${project.build.directory}/generated-sources/web3j</source>
                            </sources>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Contract-first (D6): interface controller và mô hình sinh từ api/openapi.yaml -->
                <groupId>org.openapitools</groupId>
                <artifactId>openapi-generator-maven-plugin</artifactId>
                <version>${openapi-generator.version}</version>
                <executions>
                    <execution>
                        <id>werwa-api</id>
                        <goals>
                            <goal>generate</goal>
                        </goals>
                        <configuration>
                            <inputSpec>${project.basedir}/../api/openapi.yaml</inputSpec>
                            <generatorName>spring</generatorName>
                            <apiPackage>vn.werwa.platform.openapi.api</apiPackage>
                            <modelPackage>vn.werwa.platform.openapi.model</modelPackage>
                            <!-- ApiUtil: phương thức mặc định (API chưa làm, Q20) dùng để đặt ví dụ response -->
                            <generateSupportingFiles>true</generateSupportingFiles>
                            <supportingFilesToGenerate>ApiUtil.java</supportingFilesToGenerate>
                            <generateApiDocumentation>false</generateApiDocumentation>
                            <generateModelDocumentation>false</generateModelDocumentation>
                            <generateApiTests>false</generateApiTests>
                            <generateModelTests>false</generateModelTests>
                            <configOptions>
                                <interfaceOnly>true</interfaceOnly>
                                <skipDefaultInterface>false</skipDefaultInterface>
                                <useTags>true</useTags>
                                <useSpringBoot3>true</useSpringBoot3>
                                <useJakartaEe>true</useJakartaEe>
                                <useBeanValidation>true</useBeanValidation>
                                <performBeanValidation>false</performBeanValidation>
                                <openApiNullable>false</openApiNullable>
                                <annotationLibrary>none</annotationLibrary>
                                <documentationProvider>none</documentationProvider>
                                <dateLibrary>java8</dateLibrary>
                                <useResponseEntity>true</useResponseEntity>
                            </configOptions>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
            </plugin>
            <plugin>
                <!-- Kiểm thử tích hợp (*IT) chạy ở pha integration-test, cần Docker (Testcontainers) -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <executions>
                    <execution>
                        <goals>
                            <goal>integration-test</goal>
                            <goal>verify</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <!-- Chặn build khi thiếu Java 21 hoặc Maven quá cũ -->
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-toolchain</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[21,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
